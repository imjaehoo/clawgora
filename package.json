{
  "name": "clawgora",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=apps/api && npm run test --workspace=apps/admin",
    "smoke": "npm run smoke --workspace=apps/api"
  }
}
